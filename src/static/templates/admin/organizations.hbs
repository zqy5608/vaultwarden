<main class="container-xxl">
    <header class="admin-page-header"><h1 data-i18n="Organizations">Organizations</h1><p data-i18n="Manage shared vaults and organization access.">Manage shared vaults and organization access.</p></header>
    <div id="organizations-block" class="admin-panel">
        <h2 class="admin-section-title" data-i18n="Organizations">Organizations</h2>
        <div class="table-responsive small">
            <table id="orgs-table" class="table table-sm table-striped table-hover">
                <thead>
                    <tr>
                        <th class="vw-org-details" data-i18n="Organization">Organization</th>
                        <th class="vw-users" data-i18n="Users">Users</th>
                        <th class="vw-entries" data-i18n="Entries">Entries</th>
                        <th class="vw-attachments" data-i18n="Attachments">Attachments</th>
                        <th class="vw-misc" data-i18n="Misc">Misc</th>
                        <th class="vw-actions text-end" data-i18n="Actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each page_data}}
                    <tr>
                        <td>
                            <svg width="48" height="48" class="float-start me-2 rounded" data-jdenticon-value="{{id}}"></svg>
                            <div class="float-start">
                                <strong>{{name}}</strong>
                                <span class="me-2">({{billingEmail}})</span>
                                <span class="d-block">
                                    <span class="badge bg-success font-monospace">{{id}}</span>
                                </span>
                            </div>
                        </td>
                        <td>
                            <span class="d-block">{{user_count}}</span>
                        </td>
                        <td>
                            <span class="d-block">{{cipher_count}}</span>
                        </td>
                        <td>
                            <span class="d-block"><strong><span data-i18n="Amount:">Amount:</span></strong> {{attachment_count}}</span>
                            {{#if attachment_count}}
                            <span class="d-block"><strong><span data-i18n="Size:">Size:</span></strong> {{attachment_size}}</span>
                            {{/if}}
                        </td>
                        <td>
                            <span class="d-block"><strong><span data-i18n="Collections:">Collections:</span></strong> {{collection_count}}</span>
                            <span class="d-block"><strong><span data-i18n="Groups:">Groups:</span></strong> {{group_count}}</span>
                            <span class="d-block"><strong><span data-i18n="Events:">Events:</span></strong> {{event_count}}</span>
                        </td>
                        <td class="text-end px-1 small">
                            <button type="button" class="btn btn-sm btn-link p-0 border-0 float-right" vw-delete-organization data-vw-org-uuid="{{id}}" data-vw-org-name="{{name}}" data-vw-billing-email="{{billingEmail}}" data-i18n="Delete Organization">Delete Organization</button><br>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>

        <div class="mt-3 clearfix">
            <button type="button" class="btn btn-sm btn-primary float-end" id="reload" data-i18n="Reload organizations">Reload organizations</button>
        </div>
    </div>
</main>

<link rel="stylesheet" href="{{urlpath}}/vw_static/datatables.css" />
<script src="{{urlpath}}/vw_static/datatables.js"></script>
<script src="{{urlpath}}/vw_static/admin_organizations.js"></script>
<script src="{{urlpath}}/vw_static/jdenticon-3.3.0.js"></script>
