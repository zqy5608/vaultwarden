<main class="container-xxl">
    <header class="admin-page-header"><h1 data-i18n="Diagnostics">Diagnostics</h1><p data-i18n="Review versions, environment checks and support information.">Review versions, environment checks and support information.</p></header>
    <div id="diagnostics-block" class="admin-panel">
        <h3 data-i18n="Versions">Versions</h3>
        <div class="row">
            <div class="col-md">
                <dl class="row">
                    <dt class="col-sm-5"><span data-i18n="Server Installed">Server Installed</span>
                        <span class="badge bg-success d-none abbr-badge" id="server-success" title="Latest version is installed." data-i18n-title="Latest version is installed." data-i18n="Ok">Ok</span>
                        <span class="badge bg-warning text-dark d-none abbr-badge" id="server-warning" title="An update is available." data-i18n-title="An update is available." data-i18n="Update">Update</span>
                        <span class="badge bg-info text-dark d-none abbr-badge" id="server-branch" title="This is a branched version." data-i18n-title="This is a branched version." data-i18n="Branched">Branched</span>
                    </dt>
                    <dd class="col-sm-7">
                        <span id="server-installed">{{page_data.current_release}}</span>
                    </dd>
                    <dt class="col-sm-5"><span data-i18n="Server Latest">Server Latest</span>
                        <span class="badge bg-secondary d-none abbr-badge" id="server-failed" title="Unable to determine latest version." data-i18n-title="Unable to determine latest version." data-i18n="Unknown">Unknown</span>
                    </dt>
                    <dd class="col-sm-7">
                        <span id="server-latest">{{page_data.latest_release}}<span id="server-latest-commit" class="d-none">-{{page_data.latest_commit}}</span></span>
                    </dd>
                    {{#if page_data.web_vault_enabled}}
                    <dt class="col-sm-5"><span data-i18n="Web Installed">Web Installed</span>
                        <span class="badge bg-success d-none abbr-badge" id="web-success" title="Latest version is installed." data-i18n-title="Latest version is installed." data-i18n="Ok">Ok</span>
                        <span class="badge bg-warning text-dark d-none abbr-badge" id="web-warning" title="An update is available." data-i18n-title="An update is available." data-i18n="Update">Update</span>
                        <span class="badge bg-info text-dark d-none abbr-badge" id="web-prerelease" title="You are using a pre-release version." data-i18n-title="You are using a pre-release version." data-i18n="Pre-Release">Pre-Release</span>
                    </dt>
                    <dd class="col-sm-7">
                        <span id="web-installed">{{page_data.active_web_release}}</span>
                    </dd>
                    <dt class="col-sm-5"><span data-i18n="Web Latest">Web Latest</span>
                        <span class="badge bg-secondary d-none abbr-badge" id="web-failed" title="Unable to determine latest version." data-i18n-title="Unable to determine latest version." data-i18n="Unknown">Unknown</span>
                    </dt>
                    <dd class="col-sm-7">
                        <span id="web-latest">{{page_data.latest_web_release}}</span>
                    </dd>
                    {{/if}}
                    {{#unless page_data.web_vault_enabled}}
                    <dt class="col-sm-5"><span data-i18n="Web Installed">Web Installed</span></dt>
                    <dd class="col-sm-7">
                        <span id="web-installed" data-i18n="Web Vault is disabled">Web Vault is disabled</span>
                    </dd>
                    {{/unless}}
                    <dt class="col-sm-5"><span data-i18n="Database">Database</span></dt>
                    <dd class="col-sm-7">
                        <span><b>{{page_data.db_type}}:</b> {{page_data.db_version}}</span>
                    </dd>
                </dl>
            </div>
        </div>

        <h3 data-i18n="Checks">Checks</h3>
        <div class="row">
            <div class="col-md">
                <dl class="row">
                    <dt class="col-sm-5"><span data-i18n="OS/Arch">OS/Arch</span></dt>
                    <dd class="col-sm-7">
                        <span class="d-block"><b>{{ page_data.host_os }} / {{ page_data.host_arch }}</b></span>
                    </dd>
                    <dt class="col-sm-5"><span data-i18n="Running within a container">Running within a container</span></dt>
                    <dd class="col-sm-7">
                    {{#if page_data.running_within_container}}
                        <span class="d-block"><b><span data-i18n="Yes (Base:">Yes (Base:</span> {{ page_data.container_base_image }})</b></span>
                    {{/if}}
                    {{#unless page_data.running_within_container}}
                        <span class="d-block"><b><span data-i18n="No">No</span></b></span>
                    {{/unless}}
                    </dd>
                    <dt class="col-sm-5"><span data-i18n="Uses config.json">Uses config.json</span></dt>
                    <dd class="col-sm-7">
                    {{#if (eq page_data.config_file_status "Loaded")}}
                        <span class="d-inline"><b><span data-i18n="Yes">Yes</span></b></span>
                        {{#if page_data.overrides}}
                        <span class="badge bg-info text-dark abbr-badge" title="Environment variables are overwritten by a config.json.&#013;&#010;{{page_data.overrides}}" data-i18n="Details">Details</span>
                        {{/if}}
                    {{~else if (eq page_data.config_file_status "Error")}}
                        <span class="d-inline"><b><span data-i18n="Errors">Errors</span></b></span>
                        <span class="badge bg-danger abbr-badge" title="Config file could not be loaded and was ignored. Check server logs for details." data-i18n-title="Config file could not be loaded and was ignored. Check server logs for details." data-i18n="Details">Details</span>
                    {{~else}}
                        <span class="d-inline"><b><span data-i18n="No">No</span></b></span>
                    {{/if}}
                    </dd>
                    <dt class="col-sm-5"><span data-i18n="Environment variables are valid">Environment variables are valid</span></dt>
                    <dd class="col-sm-7">
                    {{#if page_data.invalid_env_vars}}
                        <span class="d-inline"><b><span data-i18n="No">No</span></b></span>
                        <span class="badge bg-danger abbr-badge" title="Invalid environment variables are found and defaults are used instead.&#013;&#010;{{page_data.invalid_env_vars}}" data-i18n="Details">Details</span>
                    {{/if}}
                    {{#unless page_data.invalid_env_vars}}
                        <span class="d-block"><b><span data-i18n="Yes">Yes</span></b></span>
                    {{/unless}}
                    </dd>
                    <dt class="col-sm-5"><span data-i18n="Uses custom templates">Uses custom templates</span></dt>
                    <dd class="col-sm-7">
                    {{#if page_data.template_overrides}}
                        <span class="d-inline"><b><span data-i18n="Yes">Yes</span></b></span>
                        <span class="badge bg-info text-dark abbr-badge" title="Custom template files are used.&#013;&#010;{{page_data.template_overrides}}" data-i18n="Details">Details</span>
                    {{/if}}
                    {{#unless page_data.template_overrides}}
                        <span class="d-block"><b><span data-i18n="No">No</span></b></span>
                    {{/unless}}
                    </dd>
                    <dt class="col-sm-5"><span data-i18n="Uses a reverse proxy">Uses a reverse proxy</span></dt>
                    <dd class="col-sm-7">
                    {{#if page_data.ip_header_exists}}
                        <span class="d-block" title="IP Header found." data-i18n-title="IP Header found."><b><span data-i18n="Yes">Yes</span></b></span>
                    {{/if}}
                    {{#unless page_data.ip_header_exists}}
                        <span class="d-block" title="No IP Header found." data-i18n-title="No IP Header found."><b><span data-i18n="No">No</span></b></span>
                    {{/unless}}
                    </dd>
                    {{!-- Only show this if the IP Header Exists --}}
                    {{#if page_data.ip_header_exists}}
                    <dt class="col-sm-5"><span data-i18n="IP header">IP header</span>
                    {{#if page_data.ip_header_match}}
                        <span class="badge bg-success abbr-badge" title="IP_HEADER config seems to be valid." data-i18n-title="IP_HEADER config seems to be valid." data-i18n="Match">Match</span>
                    {{/if}}
                    {{#unless page_data.ip_header_match}}
                        <span class="badge bg-danger abbr-badge" title="IP_HEADER config seems to be invalid. IP's in the log could be invalid. Please fix." data-i18n-title="IP_HEADER config seems to be invalid. IP&#x27;s in the log could be invalid. Please fix." data-i18n="No Match">No Match</span>
                    {{/unless}}
                    </dt>
                    <dd class="col-sm-7">
                    {{#if page_data.ip_header_match}}
                        <span class="d-block"><b><span data-i18n="Config/Server:">Config/Server:</span></b> {{ page_data.ip_header_name }}</span>
                    {{/if}}
                    {{#unless page_data.ip_header_match}}
                        <span class="d-block"><b><span data-i18n="Config:">Config:</span></b> {{ page_data.ip_header_config }}</span>
                        <span class="d-block"><b><span data-i18n="Server:">Server:</span></b> {{ page_data.ip_header_name }}</span>
                    {{/unless}}
                    </dd>
                    {{/if}}
                    {{!-- End if IP Header Exists --}}
                    <dt class="col-sm-5"><span data-i18n="Internet access">Internet access</span>
                    {{#if page_data.has_http_access}}
                        <span class="badge bg-success abbr-badge" title="We have internet access!" data-i18n-title="We have internet access!" data-i18n="Ok">Ok</span>
                    {{/if}}
                    {{#unless page_data.has_http_access}}
                        <span class="badge bg-danger abbr-badge" title="There seems to be no internet access. Please fix." data-i18n-title="There seems to be no internet access. Please fix." data-i18n="Error">Error</span>
                    {{/unless}}
                    </dt>
                    <dd class="col-sm-7">
                    {{#if page_data.has_http_access}}
                        <span class="d-block"><b><span data-i18n="Yes">Yes</span></b></span>
                    {{/if}}
                    {{#unless page_data.has_http_access}}
                        <span class="d-block"><b><span data-i18n="No">No</span></b></span>
                    {{/unless}}
                    </dd>
                    <dt class="col-sm-5"><span data-i18n="Internet access via a proxy">Internet access via a proxy</span></dt>
                    <dd class="col-sm-7">
                    {{#if page_data.uses_proxy}}
                        <span class="d-block" title="Internet access goes via a proxy (HTTPS_PROXY or HTTP_PROXY is configured)." data-i18n-title="Internet access goes via a proxy (HTTPS_PROXY or HTTP_PROXY is configured)."><b><span data-i18n="Yes">Yes</span></b></span>
                    {{/if}}
                    {{#unless page_data.uses_proxy}}
                        <span class="d-block" title="We have direct internet access, no outgoing proxy configured." data-i18n-title="We have direct internet access, no outgoing proxy configured."><b><span data-i18n="No">No</span></b></span>
                    {{/unless}}
                    </dd>
                    <dt class="col-sm-5"><span data-i18n="Websocket enabled">Websocket enabled</span>
                        {{#if page_data.enable_websocket}}
                        <span class="badge bg-success d-none abbr-badge" id="websocket-success" title="Websocket connection is working." data-i18n-title="Websocket connection is working." data-i18n="Ok">Ok</span>
                        <span class="badge bg-danger d-none abbr-badge" id="websocket-error" title="Websocket connection error, validate your reverse proxy configuration!" data-i18n-title="Websocket connection error, validate your reverse proxy configuration!" data-i18n="Error">Error</span>
                        {{/if}}
                    </dt>
                    <dd class="col-sm-7">
                    {{#if page_data.enable_websocket}}
                        <span class="d-block" title="Websocket connections are enabled (ENABLE_WEBSOCKET is true)." data-i18n-title="Websocket connections are enabled (ENABLE_WEBSOCKET is true)."><b><span data-i18n="Yes">Yes</span></b></span>
                    {{/if}}
                    {{#unless page_data.enable_websocket}}
                        <span class="d-block" title="Websocket connections are disabled (ENABLE_WEBSOCKET is false)." data-i18n-title="Websocket connections are disabled (ENABLE_WEBSOCKET is false)."><b><span data-i18n="No">No</span></b></span>
                    {{/unless}}
                    </dd>

                    <dt class="col-sm-5"><span data-i18n="DNS (github.com)">DNS (github.com)</span>
                        <span class="badge bg-success d-none abbr-badge" id="dns-success" title="DNS Resolving works!" data-i18n-title="DNS Resolving works!" data-i18n="Ok">Ok</span>
                        <span class="badge bg-danger d-none abbr-badge" id="dns-warning" title="DNS Resolving failed. Please fix." data-i18n-title="DNS Resolving failed. Please fix." data-i18n="Error">Error</span>
                    </dt>
                    <dd class="col-sm-7">
                        <span id="dns-resolved">{{page_data.dns_resolved}}</span>
                    </dd>
                    <dt class="col-sm-5">Date & Time (Local)
                        {{#if page_data.tz_env}}
                            <span class="badge bg-success abbr-badge" title="Configured TZ environment variable" data-i18n-title="Configured TZ environment variable">{{page_data.tz_env}}</span>
                        {{/if}}
                    </dt>
                    <dd class="col-sm-7">
                        <span><b><span data-i18n="Server:">Server:</span></b> {{page_data.server_time_local}}</span>
                    </dd>
                    <dt class="col-sm-5">Date & Time (UTC)
                        <span class="badge bg-success d-none abbr-badge" id="time-success" title="Server and browser times are within 15 seconds of each other." data-i18n-title="Server and browser times are within 15 seconds of each other." data-i18n="Server/Browser Ok">Server/Browser Ok</span>
                        <span class="badge bg-danger d-none abbr-badge" id="time-warning" title="Server and browser times are more than 15 seconds apart." data-i18n-title="Server and browser times are more than 15 seconds apart." data-i18n="Server/Browser Error">Server/Browser Error</span>
                        <span class="badge bg-success d-none abbr-badge" id="ntp-server-success" title="Server and NTP times are within 15 seconds of each other." data-i18n-title="Server and NTP times are within 15 seconds of each other." data-i18n="Server NTP Ok">Server NTP Ok</span>
                        <span class="badge bg-danger d-none abbr-badge" id="ntp-server-warning" title="Server and NTP times are more than 15 seconds apart." data-i18n-title="Server and NTP times are more than 15 seconds apart." data-i18n="Server NTP Error">Server NTP Error</span>
                        <span class="badge bg-success d-none abbr-badge" id="ntp-browser-success" title="Browser and NTP times are within 15 seconds of each other." data-i18n-title="Browser and NTP times are within 15 seconds of each other." data-i18n="Browser NTP Ok">Browser NTP Ok</span>
                        <span class="badge bg-danger d-none abbr-badge" id="ntp-browser-warning" title="Browser and NTP times are more than 15 seconds apart." data-i18n-title="Browser and NTP times are more than 15 seconds apart." data-i18n="Browser NTP Error">Browser NTP Error</span>
                    </dt>
                    <dd class="col-sm-7">
                        <span id="ntp-time" class="d-block"><b><span data-i18n="NTP:">NTP:</span></b> <span id="ntp-server-string">{{page_data.ntp_time}}</span></span>
                        <span id="time-server" class="d-block"><b><span data-i18n="Server:">Server:</span></b> <span id="time-server-string">{{page_data.server_time}}</span></span>
                        <span id="time-browser" class="d-block"><b><span data-i18n="Browser:">Browser:</span></b> <span id="time-browser-string"></span></span>
                    </dd>

                    <dt class="col-sm-5"><span data-i18n="Domain configuration">Domain configuration</span>
                        <span class="badge bg-success d-none abbr-badge" id="domain-success" title="The domain variable matches the browser location and seems to be configured correctly." data-i18n-title="The domain variable matches the browser location and seems to be configured correctly." data-i18n="Match">Match</span>
                        <span class="badge bg-danger d-none abbr-badge" id="domain-warning" title="The domain variable does not match the browser location.&#013;&#010;The domain variable does not seem to be configured correctly.&#013;&#010;Some features may not work as expected!" data-i18n-title="The domain variable does not match the browser location. The domain variable does not seem to be configured correctly. Some features may not work as expected!" data-i18n="No Match">No Match</span>
                        <span class="badge bg-success d-none abbr-badge" id="https-success" title="Configured to use HTTPS" data-i18n-title="Configured to use HTTPS" data-i18n="HTTPS">HTTPS</span>
                        <span class="badge bg-danger d-none abbr-badge" id="https-warning" title="Not configured to use HTTPS.&#013;&#010;Some features may not work as expected!" data-i18n-title="Not configured to use HTTPS. Some features may not work as expected!" data-i18n="No HTTPS">No HTTPS</span>
                    </dt>
                    <dd class="col-sm-7">
                        <span id="domain-server" class="d-block"><b><span data-i18n="Server:">Server:</span></b> <span id="domain-server-string">{{page_data.admin_url}}</span></span>
                        <span id="domain-browser" class="d-block"><b><span data-i18n="Browser:">Browser:</span></b> <span id="domain-browser-string"></span></span>
                    </dd>

                    <dt class="col-sm-5"><span data-i18n="HTTP Response validation">HTTP Response validation</span>
                        <span class="badge bg-success d-none abbr-badge" id="http-response-success" title="All headers and HTTP request responses seem to be ok." data-i18n-title="All headers and HTTP request responses seem to be ok." data-i18n="Ok">Ok</span>
                        <span class="badge bg-danger d-none abbr-badge" id="http-response-warning" title="Some headers or HTTP request responses return invalid data!" data-i18n-title="Some headers or HTTP request responses return invalid data!" data-i18n="Error">Error</span>
                    </dt>
                    <dd class="col-sm-7">
                        <span id="http-response-errors" class="d-block"></span>
                    </dd>
                    {{#if page_data.invalid_feature_flags}}
                    <dt class="col-sm-5"><span data-i18n="Invalid Feature Flags">Invalid Feature Flags</span>
                        <span class="badge bg-warning text-dark abbr-badge" id="feature-flag-warning" title="Some feature flags are invalid or outdated!" data-i18n-title="Some feature flags are invalid or outdated!" data-i18n="Warning">Warning</span>
                    </dt>
                    <dd class="col-sm-7">
                        <span id="feature-flags" class="d-block"><b><span data-i18n="Flags:">Flags:</span></b> <span id="feature-flags-string">{{page_data.invalid_feature_flags}}</span></span>
                    </dd>
                    {{/if}}
                </dl>
            </div>
        </div>

        <h3 data-i18n="Support">Support</h3>
        <div class="row">
            <div class="col-md">
                <dl class="row">
                    <dd class="col-sm-12">
                        <span data-i18n="If you need support please check the following links first before you create a new issue:">If you need support please check the following links first before you create a new issue:</span>
                         <a href="https://vaultwarden.discourse.group/" target="_blank" rel="noreferrer noopener" data-i18n="Vaultwarden Forum">Vaultwarden Forum</a>
                         | <a href="https://github.com/dani-garcia/vaultwarden/discussions" target="_blank" rel="noreferrer noopener" data-i18n="Github Discussions">Github Discussions</a>
                    </dd>
                </dl>
                <dl class="row">
                    <dd class="col-sm-12">
                        <span data-i18n="You can use the button below to pre-generate a string which you can copy/paste on either the Forum or when Creating a new issue at Github.">You can use the button below to pre-generate a string which you can copy/paste on either the Forum or when Creating a new issue at Github.</span><br>
                        <span data-i18n="We try to hide the most sensitive values from the generated support string by default, but please verify if there is nothing in there which you want to hide!">We try to hide the most sensitive values from the generated support string by default, but please verify if there is nothing in there which you want to hide!</span><br>
                    </dd>
                </dl>
                <dl class="row">
                    <dt class="col-sm-3">
                        <button type="button" id="gen-support" class="btn btn-primary" data-i18n="Generate Support String">Generate Support String</button>
                        <br><br>
                        <button type="button" id="copy-support" class="btn btn-info mb-3 d-none" data-i18n="Copy To Clipboard">Copy To Clipboard</button>
                        <div class="toast-container position-absolute float-start vw-copy-toast">
                            <div id="toastClipboardCopy" class="toast fade hide" role="status" aria-live="polite" aria-atomic="true" data-bs-autohide="true" data-bs-delay="1500">
                                <div class="toast-body">
                                    <span data-i18n="Copied to clipboard!">Copied to clipboard!</span>
                                </div>
                            </div>
                        </div>
                    </dt>
                    <dd class="col-sm-9">
                        <pre id="support-string" class="pre-scrollable d-none w-100 border p-2"></pre>
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</main>
<script src="{{urlpath}}/vw_static/admin_diagnostics.js"></script>
<script type="application/json" id="diagnostics_json">{{to_json page_data}}</script>
