<main class="container-xxl">
    <div class="my-3 p-3 rounded shadow">
        <h6 class="border-bottom pb-2 mb-3">Agent API</h6>
        <p class="small mb-2">
            Fork-specific fill-only API at <code>/api/agent</code>. It is
            {{#if page_data.enabled}}<strong>enabled</strong>{{else}}<strong>disabled</strong>{{/if}}.
            AI tokens cannot read passwords. Only a registered fill agent can redeem a ticket.
            {{#if page_data.requireFolderAcl}}New AI tokens need a folder allowlist.{{/if}}
        </p>
        <p class="small text-body-secondary">Credentials are shown once. Store them outside the vault. Revoking a credential blocks it immediately.</p>

        <div id="agent-secret-panel" class="alert alert-warning" hidden>
            <div class="fw-semibold">Copy this credential now. It will not be shown again.</div>
            <pre id="agent-secret-value" class="mb-2 user-select-all"></pre>
            <button type="button" class="btn btn-sm btn-secondary" id="agent-secret-done">Done</button>
        </div>

        <div class="row g-3">
            <div class="col-lg-6">
                <h6>AI agent token</h6>
                <form id="agent-token-form" class="row g-2">
                    <div class="col-12">
                        <label class="form-label small" for="agent-user-email">User email</label>
                        <input class="form-control form-control-sm" id="agent-user-email" autocomplete="off" required>
                    </div>
                    <div class="col-12">
                        <label class="form-label small" for="agent-token-name">Name</label>
                        <input class="form-control form-control-sm" id="agent-token-name" autocomplete="off" required>
                    </div>
                    <div class="col-12">
                        <label class="form-label small" for="agent-folder-ids">Folder UUIDs</label>
                        <input class="form-control form-control-sm" id="agent-folder-ids" autocomplete="off" placeholder="comma-separated">
                    </div>
                    <div class="col-12">
                        <button class="btn btn-sm btn-primary" type="submit">Create agent token</button>
                    </div>
                </form>
            </div>
            <div class="col-lg-6">
                <h6>Fill agent</h6>
                <form id="fill-agent-form" class="row g-2">
                    <div class="col-12">
                        <label class="form-label small" for="fill-agent-email">User email</label>
                        <input class="form-control form-control-sm" id="fill-agent-email" autocomplete="off" required>
                    </div>
                    <div class="col-12">
                        <label class="form-label small" for="fill-agent-name">Name</label>
                        <input class="form-control form-control-sm" id="fill-agent-name" autocomplete="off" required>
                    </div>
                    <div class="col-12">
                        <button class="btn btn-sm btn-primary" type="submit">Create fill agent</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="my-3 p-3 rounded shadow">
        <h6 class="border-bottom pb-2 mb-3">AI tokens</h6>
        <div class="table-responsive-xl small">
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Name</th>
                        <th>Prefix</th>
                        <th>Folders</th>
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {{#each page_data.tokens}}
                    <tr>
                        <td>{{email}}</td>
                        <td>{{name}}</td>
                        <td><code>{{tokenPrefix}}</code></td>
                        <td>{{#each folderIds}}<div><code>{{this}}</code></div>{{/each}}</td>
                        <td>{{createdAt}}</td>
                        <td class="text-end">
                            {{#if revoked}}
                            <span class="badge bg-secondary">Revoked</span>
                            {{else}}
                            <button type="button" class="btn btn-sm btn-outline-danger" data-agent-revoke="token" data-agent-id="{{id}}">Revoke</button>
                            {{/if}}
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>

    <div class="my-3 p-3 rounded shadow">
        <h6 class="border-bottom pb-2 mb-3">Fill agents</h6>
        <div class="table-responsive-xl small">
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Name</th>
                        <th>Id</th>
                        <th>Prefix</th>
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {{#each page_data.fillAgents}}
                    <tr>
                        <td>{{email}}</td>
                        <td>{{name}}</td>
                        <td><code>{{id}}</code></td>
                        <td><code>{{tokenPrefix}}</code></td>
                        <td>{{createdAt}}</td>
                        <td class="text-end">
                            {{#if revoked}}
                            <span class="badge bg-secondary">Revoked</span>
                            {{else}}
                            <button type="button" class="btn btn-sm btn-outline-danger" data-agent-revoke="fill" data-agent-id="{{id}}">Revoke</button>
                            {{/if}}
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        <p class="small text-body-secondary mb-0">The fill agent id is not a secret. The AI client sends it when requesting a fill. The <code>vwfill_</code> token is the credential that redeems the ticket.</p>
    </div>

    <div class="my-3 p-3 rounded shadow">
        <h6 class="border-bottom pb-2 mb-3">Recent agent audit</h6>
        <div class="table-responsive-xl small">
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>Action</th>
                        <th>Detail</th>
                        <th>Origin</th>
                        <th>IP</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each page_data.audit}}
                    <tr>
                        <td>{{createdAt}}</td>
                        <td>{{action}}</td>
                        <td>{{detail}}</td>
                        <td>{{origin}}</td>
                        <td>{{ip}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</main>
