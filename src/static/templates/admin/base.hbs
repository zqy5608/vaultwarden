<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/png" href="{{urlpath}}/vw_static/vaultwarden-favicon.png">
    <title data-i18n="Vaultwarden Admin Panel">Vaultwarden Admin Panel</title>
    <link rel="stylesheet" href="{{urlpath}}/vw_static/bootstrap.css" />
    <link rel="stylesheet" href="{{urlpath}}/vw_static/admin.css" />
    <script src="{{urlpath}}/vw_static/admin_zh.js"></script>
    <script src="{{urlpath}}/vw_static/admin_i18n.js"></script>
    <script src="{{urlpath}}/vw_static/admin.js"></script>
</head>
<body>
    <a class="admin-skip-link" href="#admin-content" data-i18n="Skip to content">Skip to content</a>
    <svg xmlns="http://www.w3.org/2000/svg" class="d-none">
        <symbol id="vw-icon-sun" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="5" fill="currentColor"/>
            <g stroke="currentColor" stroke-linecap="round" stroke-width="1.5">
                <path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"/>
            </g>
        </symbol>
        <symbol id="vw-icon-moon" viewBox="0 0 24 24">
            <path fill="currentColor" stroke-width=".8" d="M18.4 17.8A9 8.6 0 0 1 13 2a10.5 10 0 1 0 9 14.4 9.4 9 0 0 1-3.6 1.4"/>
        </symbol>
        <symbol id="vw-icon-auto" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.5"/>
            <path fill="currentColor" d="M12 3a9 9 0 1 1 0 18Z"/>
        </symbol>
        <symbol id="vw-icon-settings" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z"/><path d="m9 3-1 3-3 1-2 3 2 2-1 3 2 3 3-1 3 2 3-2 3 1 2-3-1-3 2-2-2-3-3-1-1-3Z"/></symbol>
        <symbol id="vw-icon-users" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></symbol>
        <symbol id="vw-icon-organizations" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V7h7v14M10 3h11v18M1 21h22M14 7h3m-3 4h3m-3 4h3M6 11h1m-1 4h1"/></symbol>
        <symbol id="vw-icon-diagnostics" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h5l3-8 4 16 3-8h5"/></symbol>
        <symbol id="vw-icon-agents" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="7" width="16" height="14" rx="4"/><path d="M12 3v4M1 12v5m22-5v5m-15-5h1m6 0h1m-7 4h6"/></symbol>
        <symbol id="vw-icon-external" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3h7v7m0-7L10 14M10 3H3v18h18v-7"/></symbol>
        <symbol id="vw-icon-logout" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H3v18h6m7-14 5 5-5 5M8 12h13"/></symbol>
    </svg>
    <nav class="admin-sidebar navbar navbar-expand-lg" aria-label="Administration" data-i18n-aria-label="Administration">
        <div class="admin-brand-row">
            <a class="navbar-brand" href="{{urlpath}}/admin"><img class="vaultwarden-icon" src="{{urlpath}}/vw_static/vaultwarden-icon.png" alt=""><span>Vaultwarden <small data-i18n="/ Admin">/ Admin</small></span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation" data-i18n-aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
        </div>
        <div class="collapse navbar-collapse" id="navbarCollapse">
            {{#if logged_in}}
            <div class="admin-nav-caption" data-i18n="WORKSPACE">WORKSPACE</div>
            <ul class="navbar-nav admin-primary-nav">
                <li class="nav-item"><a class="nav-link" href="{{urlpath}}/admin"><svg class="admin-nav-icon" aria-hidden="true"><use href="#vw-icon-settings"></use></svg><span data-i18n="Settings">Settings</span></a></li>
                <li class="nav-item"><a class="nav-link" href="{{urlpath}}/admin/users/overview"><svg class="admin-nav-icon" aria-hidden="true"><use href="#vw-icon-users"></use></svg><span data-i18n="Users">Users</span></a></li>
                <li class="nav-item"><a class="nav-link" href="{{urlpath}}/admin/organizations/overview"><svg class="admin-nav-icon" aria-hidden="true"><use href="#vw-icon-organizations"></use></svg><span data-i18n="Organizations">Organizations</span></a></li>
                <li class="nav-item"><a class="nav-link" href="{{urlpath}}/admin/diagnostics"><svg class="admin-nav-icon" aria-hidden="true"><use href="#vw-icon-diagnostics"></use></svg><span data-i18n="Diagnostics">Diagnostics</span></a></li>
                <li class="nav-item"><a class="nav-link" href="{{urlpath}}/admin/agents"><svg class="admin-nav-icon" aria-hidden="true"><use href="#vw-icon-agents"></use></svg><span data-i18n="Agent API">Agent API</span></a></li>
            </ul>
            {{/if}}
            <div class="admin-nav-footer">
                <div class="admin-language">
                    <label for="admin-language" data-i18n="Language">Language</label>
                    <select id="admin-language" class="form-select form-select-sm">
                        <option value="zh-CN">简体中文</option>
                        <option value="en">English</option>
                    </select>
                </div>
                <a class="nav-link" href="{{urlpath}}/" target="_blank" rel="noreferrer"><svg class="admin-nav-icon" aria-hidden="true"><use href="#vw-icon-external"></use></svg><span data-i18n="Open vault">Open vault</span></a>
                <ul class="navbar-nav admin-theme">
                    <li class="nav-item dropup">
                        <button
                            class="btn btn-link nav-link admin-theme-button dropdown-toggle d-flex align-items-center"
                            id="bd-theme" type="button" aria-expanded="false" data-bs-toggle="dropdown"
                            data-bs-display="static" aria-label="Toggle theme (auto)" data-i18n-aria-label="Toggle theme (auto)">
                            <span class="my-1 fs-4 theme-icon-active">
                                <svg class="vw-theme-icon" focusable="false" aria-hidden="true">
                                    <use data-theme-icon-use href="#vw-icon-auto"></use>
                                </svg>
                            </span>
                            <span class="ms-2" id="bd-theme-text" data-i18n="Theme">Theme</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="bd-theme-text">
                            <li>
                                <button type="button" class="dropdown-item d-flex align-items-center"
                                    data-bs-theme-value="light" aria-pressed="false">
                                    <span class="me-2 fs-4 theme-icon">
                                        <svg class="vw-theme-icon" focusable="false" aria-hidden="true">
                                            <use data-theme-icon-use href="#vw-icon-sun"></use>
                                        </svg>
                                    </span>
                                    <span data-i18n="Light">Light</span>
                                </button>
                            </li>
                            <li>
                                <button type="button" class="dropdown-item d-flex align-items-center"
                                    data-bs-theme-value="dark" aria-pressed="false">
                                    <span class="me-2 fs-4 theme-icon">
                                        <svg class="vw-theme-icon" focusable="false" aria-hidden="true">
                                            <use data-theme-icon-use href="#vw-icon-moon"></use>
                                        </svg>
                                    </span>
                                    <span data-i18n="Dark">Dark</span>
                                </button>
                            </li>
                            <li>
                                <button type="button" class="dropdown-item d-flex align-items-center active"
                                    data-bs-theme-value="auto" aria-pressed="true">
                                    <span class="me-2 fs-4 theme-icon">
                                        <svg class="vw-theme-icon" focusable="false" aria-hidden="true">
                                            <use data-theme-icon-use href="#vw-icon-auto"></use>
                                        </svg>
                                    </span>
                                    <span data-i18n="Auto">Auto</span>
                                </button>
                            </li>
                        </ul>
                    </li>
                </ul>

                {{#if logged_in}}
                <a class="nav-link" href="{{urlpath}}/admin/logout"><svg class="admin-nav-icon" aria-hidden="true"><use href="#vw-icon-logout"></use></svg><span data-i18n="Log out">Log out</span></a>
                {{/if}}
            </div>
        </div>
    </nav>
    <div class="admin-workspace">
        <div class="admin-topbar"><span><span data-i18n="Administration">Administration</span> <span class="admin-breadcrumb-divider">/</span> <span data-i18n="Control panel">Control panel</span></span><span class="admin-topbar-label" data-i18n="Vaultwarden Admin">Vaultwarden Admin</span></div>
        <div class="admin-content" id="admin-content" tabindex="-1">
            {{> (lookup this "page_content") }}
        </div>
    </div>
    <!-- Bootstrap must follow the page content and its scripts. -->
    <script src="{{urlpath}}/vw_static/bootstrap.bundle.js"></script>
</body>
</html>
