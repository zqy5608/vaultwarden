<main class="container-xxl">
    <header class="admin-page-header"><h1 data-i18n="Users">Users</h1><p data-i18n="Manage accounts, invitations and access.">Manage accounts, invitations and access.</p></header>
    <div id="users-block" class="admin-panel">
        <h2 class="admin-section-title" data-i18n="Registered Users">Registered Users</h2>
        <div class="table-responsive small">
            <table id="users-table" class="table table-sm table-striped table-hover">
                <thead>
                    <tr>
                        <th class="vw-account-details" data-i18n="User">User</th>
                        {{#if sso_enabled}}
                        <th class="vw-sso-identifier" data-i18n="SSO Identifier">SSO Identifier</th>
                        {{/if}}
                        <th class="vw-created-at" data-i18n="Created at">Created at</th>
                        <th class="vw-last-active" data-i18n="Last Active">Last Active</th>
                        <th class="vw-entries" data-i18n="Entries">Entries</th>
                        <th class="vw-attachments" data-i18n="Attachments">Attachments</th>
                        <th class="vw-organizations" data-i18n="Organizations">Organizations</th>
                        <th class="vw-actions text-end" data-i18n="Actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each page_data}}
                    <tr>
                        <td>
                            <svg width="48" height="48" class="float-start me-2 rounded" data-jdenticon-value="{{email}}"></svg>
                            <div>
                                <strong>{{name}}</strong>
                                <span class="d-block">{{email}}</span>
                                <span class="d-block">
                                    {{#unless user_enabled}}
                                        <span class="badge bg-danger me-2" title="User is disabled" data-i18n-title="User is disabled" data-i18n="Disabled">Disabled</span>
                                    {{/unless}}
                                    {{#if twoFactorEnabled}}
                                        <span class="badge bg-success me-2" title="2FA is enabled" data-i18n-title="2FA is enabled" data-i18n="2FA">2FA</span>
                                    {{/if}}
                                    {{#case _status 1}}
                                        <span class="badge bg-warning text-dark me-2" title="User is invited" data-i18n-title="User is invited" data-i18n="Invited">Invited</span>
                                    {{/case}}
                                    {{#if emailVerified}}
                                        <span class="badge bg-success me-2" title="Email has been verified" data-i18n-title="Email has been verified" data-i18n="Verified">Verified</span>
                                    {{/if}}
                                </span>
                            </div>
                        </td>
                        {{#if ../sso_enabled}}
                        <td>
                            <span class="d-block text-break text-wrap">{{sso_identifier}}</span>
                        </td>
                        {{/if}}
                        <td>
                            <span class="d-block" data-sort-type="date-iso">{{created_at}}</span>
                        </td>
                        <td>
                            <span class="d-block" data-sort-type="date-iso">{{last_active}}</span>
                        </td>
                        <td>
                            <span class="d-block">{{cipher_count}}</span>
                        </td>
                        <td>
                            <span class="d-block"><strong><span data-i18n="Amount:">Amount:</span></strong> {{attachment_count}}</span>
                            {{#if attachment_count}}
                            <span class="d-block"><strong><span data-i18n="Size:">Size:</span></strong> {{attachment_size}}</span>
                            {{/if}}
                        </td>
                        <td>
                            <div class="overflow-auto vw-org-cell" data-vw-user-email="{{email}}" data-vw-user-uuid="{{id}}">
                            {{#each organizations}}
                            <button class="badge" data-bs-toggle="modal" data-bs-target="#userOrgTypeDialog" data-vw-org-type="{{type}}" data-vw-org-uuid="{{id}}" data-vw-org-name="{{name}}">{{name}}</button>
                            {{/each}}
                            </div>
                        </td>
                        <td class="text-end px-1 small">
                            <span data-vw-user-uuid="{{id}}" data-vw-user-email="{{email}}">
                                {{#if twoFactorEnabled}}
                                <button type="button" class="btn btn-sm btn-link p-0 border-0 float-right" vw-remove2fa data-i18n="Remove all 2FA">Remove all 2FA</button><br>
                                {{/if}}
                                <button type="button" class="btn btn-sm btn-link p-0 border-0 float-right" vw-deauth-user data-i18n="Deauthorize sessions">Deauthorize sessions</button><br>
                                <button type="button" class="btn btn-sm btn-link p-0 border-0 float-right" vw-delete-user data-i18n="Delete User">Delete User</button><br>
                                {{#if ../sso_enabled}}
                                <button type="button" class="btn btn-sm btn-link p-0 border-0 float-right" vw-delete-sso-user data-i18n="Delete SSO Association">Delete SSO Association</button><br>
                                {{/if}}
                                {{#if user_enabled}}
                                <button type="button" class="btn btn-sm btn-link p-0 border-0 float-right" vw-disable-user data-i18n="Disable User">Disable User</button><br>
                                {{else}}
                                <button type="button" class="btn btn-sm btn-link p-0 border-0 float-right" vw-enable-user data-i18n="Enable User">Enable User</button><br>
                                {{/if}}
                                {{#case _status 1}}
                                <button type="button" class="btn btn-sm btn-link p-0 border-0 float-right" vw-resend-user-invite data-i18n="Resend invite">Resend invite</button><br>
                                {{/case}}
                            </span>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>

        <div class="mt-3 clearfix">
            <button type="button" class="btn btn-sm btn-danger" id="updateRevisions"
                title="Force all clients to fetch new data next time they connect. Useful after restoring a backup to remove any stale data." data-i18n-title="Force all clients to fetch new data next time they connect. Useful after restoring a backup to remove any stale data.">
                <span data-i18n="Force clients to resync">Force clients to resync</span>
            </button>

            <button type="button" class="btn btn-sm btn-primary float-end" id="reload" data-i18n="Reload users">Reload users</button>
        </div>
    </div>

    <div id="inviteUserFormBlock" class="admin-panel">
        <div>
            <h2 class="admin-section-title" data-i18n="Invite User">Invite User</h2>
            <label class="form-label" for="inviteEmail" data-i18n="Email">Email</label>

            <form class="form-inline input-group admin-invite-form" id="inviteUserForm">
                <input type="email" class="form-control me-2" id="inviteEmail" placeholder="Enter email" required spellcheck="false" data-i18n-placeholder="Enter email">
                <button type="submit" class="btn btn-primary" data-i18n="Invite">Invite</button>
            </form>
        </div>
    </div>

    <div id="userOrgTypeDialog" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">
                        <b><span data-i18n="Update User Type:">Update User Type:</span></b><br><b><span data-i18n="Organization:">Organization:</span></b> <span id="userOrgTypeDialogOrgName"></span><br><b><span data-i18n="User:">User:</span></b> <span id="userOrgTypeDialogUserEmail"></span>
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" data-i18n-aria-label="Close"></button>
                </div>
                <form class="form" id="userOrgTypeForm">
                    <input type="hidden" name="user_uuid" id="userOrgTypeUserUuid" value="">
                    <input type="hidden" name="org_uuid" id="userOrgTypeOrgUuid" value="">
                    <div class="modal-body">
                        <div class="radio">
                            <label><input type="radio" value="2" class="form-radio-input" name="user_type" id="userOrgTypeUser">&nbsp;<span data-i18n="User">User</span></label>
                        </div>
                        <div class="radio">
                            <label><input type="radio" value="3" class="form-radio-input" name="user_type" id="userOrgTypeManager">&nbsp;<span data-i18n="Manager">Manager</span></label>
                        </div>
                        <div class="radio">
                            <label><input type="radio" value="1" class="form-radio-input" name="user_type" id="userOrgTypeAdmin">&nbsp;<span data-i18n="Admin">Admin</span></label>
                        </div>
                        <div class="radio">
                            <label><input type="radio" value="0" class="form-radio-input" name="user_type" id="userOrgTypeOwner">&nbsp;<span data-i18n="Owner">Owner</span></label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal" data-i18n="Cancel">Cancel</button>
                        <button type="submit" class="btn btn-sm btn-primary" data-i18n="Change Role">Change Role</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>

<link rel="stylesheet" href="{{urlpath}}/vw_static/datatables.css" />
<script src="{{urlpath}}/vw_static/datatables.js"></script>
<script src="{{urlpath}}/vw_static/admin_users.js"></script>
<script src="{{urlpath}}/vw_static/jdenticon-3.3.0.js"></script>
