[Unit]
Description=Trusted headless Vaultwarden login broker
Wants=vaultwarden-agent-automation.service
After=vaultwarden-agent-automation.service network-online.target

[Service]
Type=exec
User=vaultwarden-agent
Group=vaultwarden-agent
RuntimeDirectory=vaultwarden-agent
RuntimeDirectoryMode=0700
UMask=0077
LoadCredentialEncrypted=broker-config:/etc/vaultwarden-agent/broker-config.cred
LoadCredential=automation-ca:/etc/vaultwarden-agent/automation-ca.crt
Environment=HOME=/run/vaultwarden-agent/home
Environment=XDG_CONFIG_HOME=/run/vaultwarden-agent/config
Environment=XDG_CACHE_HOME=/run/vaultwarden-agent/cache
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/vaultwarden-agent/browsers
Environment=SSL_CERT_FILE=%d/automation-ca
ExecStart=/opt/vaultwarden-agent/venv/bin/vaultwarden-agent-broker --config %d/broker-config --socket /run/vaultwarden-agent/broker.sock
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
PrivateTmp=true
LimitCORE=0
MemoryMax=2G
CPUQuota=100%
TimeoutStopSec=20
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
