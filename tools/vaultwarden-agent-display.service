[Unit]
Description=Private Vaultwarden confirmation display

[Service]
Type=exec
User=vaultwarden-agent
Group=vaultwarden-agent
RuntimeDirectory=vaultwarden-agent-ui
RuntimeDirectoryMode=0700
UMask=0077
ExecStart=/opt/vaultwarden-agent/bin/native-display
ExecStartPost=/usr/bin/timeout 10 /bin/sh -c 'until [ -S /tmp/.X11-unix/X99 ]; do sleep 0.1; done'
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
PrivateTmp=true
LimitCORE=0
MemoryMax=256M
StandardOutput=null
StandardError=null
